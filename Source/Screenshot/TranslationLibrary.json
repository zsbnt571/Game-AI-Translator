  "Presets": [
    {
      "Id": "ao3-fusion",
      "Name": "AO3 译者 · Fusion 适配",
      "Description": "用于小说式叙事和人物对白。参考 AO3 译者的阅读体验，由 Fusion 重写为游戏格式；不是上游原提示词。",
      "Instructions": "Translate narrative and dialogue as an attentive literary translator of character-driven fiction. Convey subtext, emotional tension, intimacy, humor and shifts in register supported by the text. Keep each speaker's voice distinct; preserve relationships, power dynamics, perspective, names and pronouns when known. In narration, use fluent target-language prose and natural rhythm. Translate slang, profanity and sexual language at the original level of explicitness, without censorship or added intensity. Do not infer fandom lore or relationships from familiarity with a name. Keep unfinished speech unfinished. Menus remain functional and short. Never add footnotes or commentary.",
      "Source": "参考：Immersive AO3；Fusion 独立适配",
      "SourceUrl": "https://github.com/immersive-translate/prompts/blob/main/plugins/ao3.yml"
    },
    {
      "Id": "gal-dialogue",
      "Name": "Galgame 剧情对白",
      "Description": "区分人物台词、旁白和内心活动，保留语气与停顿；没有可靠信息时不猜人物关系。",
      "Instructions": "Translate visual-novel dialogue and narration according to supplied speaker and scene context. Preserve person, tense, intent, hesitation, interruption, meaningful repetition and character-specific formality. A speaker label is evidence, not text to append. Do not invent speakers, gender, relationships or omitted subjects when ambiguous. Render Japanese address terms naturally according to established context and glossary. Do not impose first-person narration on third-person text. Keep system UI short without compressing dialogue.",
      "Source": "Fusion；参考 GalTransl 的场景分类",
      "SourceUrl": "https://github.com/GalTransl/GalTransl"
    },
    {
      "Id": "faithful-dialogue",
      "Name": "忠实对白",
      "Description": "优先保留意思、程度和句子是否完整；减少擅自润色和补写。",
      "Instructions": "Translate accurately with minimal interpretive embellishment. Preserve agents, actions, objects, negation, uncertainty, intensity and register. Use grammatical idiomatic target language without completing fragments, resolving ambiguous relationships without evidence, or adding explanations. Preserve the difference between narration, speech and internal monologue. Maintain recurring terminology and all protected text.",
      "Source": "Fusion；参考 LinguaGacha 的忠实翻译原则",
      "SourceUrl": "https://github.com/neavo/LinguaGacha"
    },
    {
      "Id": "short-ui",
      "Name": "菜单与短句",
      "Description": "适合选项、按钮、道具和状态说明。保留操作条件、数值及必要信息。",
      "Instructions": "Translate functional game interface text using conventional concise target-language labels. Distinguish commands, settings, item names, states and notifications. Keep prerequisites, negation, timing, quantity and effect intact. Brevity must not remove essential information. If the supplied item is dialogue or prose, translate the complete meaning naturally instead of turning it into a button label.",
      "Source": "Fusion",
      "SourceUrl": ""
    },
    {
      "Id": "social-dialogue",
      "Name": "推特与网络表达",
      "Description": "适合游戏里的社交帖文、短信和网络对白。按语境处理缩写、俚语、表情与反讽，保留账号、链接及话题标识。",
      "Instructions": "Handle short social posts, in-game messages and online conversation. Keep the social intent of jokes, teasing, irony, slang and clipped speech. Choose a natural target-language equivalent only when the context supports that meaning; do not expand an ambiguous abbreviation by guessing. Keep usernames, @handles, URLs, emoji and searchable hashtag tokens unchanged. Preserve quotation boundaries, repetitions and abrupt endings. Do not add slang or sarcasm absent from the source. Translate narrative and functional UI normally when they occur alongside messages. Return only the translation required by the surrounding game contract, with no notes or added context.",
      "Source": "Fusion 独立适配；参考 Immersive Twitter 场景",
      "SourceUrl": "https://github.com/immersive-translate/prompts/blob/main/plugins/twitter.yml"
    },
    {
      "Id": "game-community",
      "Name": "玩家交流与社区",
      "Description": "适合玩家讨论、评价、攻略短句和多人聊天。保留版本、数值、按键与游戏专名，不随意把普通词改成游戏黑话。",
      "Instructions": "Translate player discussion, game reviews, strategy advice and multiplayer chat. Interpret gaming jargon using the supplied game context and selected glossary, without assuming a particular franchise. Preserve whether a statement is opinion, rumor, instruction, complaint or a joke, and preserve negation and uncertainty. Keep version strings, build identifiers, key bindings, usernames, item stats and protected variables intact. When an acronym has more than one plausible meaning, retain it rather than inventing an expansion. Maintain the speaker's politeness or hostility without intensifying it. Keep dialogue complete and do not add review scores, explanations or advice.",
      "Source": "Fusion 独立适配；参考 Immersive Steam / Reddit 场景",
      "SourceUrl": "https://github.com/immersive-translate/prompts/blob/main/plugins/steam.yml"
    }
  ],
