<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>FusionUnityEmbedded</AssemblyName><Version>0.6.0.134</Version><Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo><EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute><DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences><NoStdLib>true</NoStdLib>
    <LoaderDirectory Condition="'$(LoaderDirectory)' == ''">$(FusionBuildRoot)\References\Mono6</LoaderDirectory>
    <FrameworkReferenceDirectory Condition="'$(FrameworkReferenceDirectory)' == ''">$(MSBuildThisFileDirectory)..\References</FrameworkReferenceDirectory>
    <FrameworkPathOverride>$(FrameworkReferenceDirectory)</FrameworkPathOverride>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BridgeJson.cs;TextLookup.cs;UnityPipeStream.cs;UnityBridgeRuntime.cs;LegacyTextProjection.cs;BufferedTmpProjection.cs;CjkTextLayout.cs;LegacyTextRegion.cs;StaticTmpFonts.cs;NativeTmpPreprocessor.cs;IncrementalTextState.cs;DisplaySourceHooks.cs;Mono6Plugin.cs" />
    <Reference Include="BepInEx.Core"><HintPath>$(LoaderDirectory)\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.Mono"><HintPath>$(LoaderDirectory)\BepInEx.Unity.Mono.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(LoaderDirectory)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="mscorlib"><HintPath>$(FrameworkReferenceDirectory)\mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(FrameworkReferenceDirectory)\System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(FrameworkReferenceDirectory)\System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(FrameworkReferenceDirectory)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="FontAssets/*"><LogicalName>Fusion.UnityEmbedded.FontAssets.%(Filename)%(Extension)</LogicalName></EmbeddedResource></ItemGroup>
</Project>
