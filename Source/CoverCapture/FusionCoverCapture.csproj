<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FusionCoverCapture</AssemblyName>
    <Version>1.1.154</Version><AssemblyVersion>1.1.0.154</AssemblyVersion>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3"/>
    <Compile Include="..\Screenshot\FusionCoverWindowIdentity.cs" Link="CoverWindowIdentity.cs"/>
    <Compile Include="..\Screenshot\FusionCoverQuality.cs" Link="CoverQuality.cs"/>
  </ItemGroup>
  <Target Name="PreserveWindowsSdkReferenceVersion" AfterTargets="AddWindowsSdkKnownFrameworkReferences" Condition="'$(RuntimeFrameworkVersion)' != ''">
    <!-- A .NET runtime patch version is not a Windows SDK reference version. -->
    <ItemGroup>
      <_FusionWindowsSdkFramework Include="@(KnownFrameworkReference)" Condition="'%(KnownFrameworkReference.Identity)' == 'Microsoft.Windows.SDK.NET.Ref' And '%(KnownFrameworkReference.TargetFramework)' == '$(TargetFramework)'" />
      <FrameworkReference Include="Microsoft.Windows.SDK.NET.Ref" RuntimeFrameworkVersion="@(_FusionWindowsSdkFramework->'%(DefaultRuntimeFrameworkVersion)')" />
      <FrameworkReference Condition="'%(FrameworkReference.Identity)' == 'Microsoft.Windows.SDK.NET.Ref.Windows'">
        <RuntimeFrameworkVersion>@(_FusionWindowsSdkFramework->'%(DefaultRuntimeFrameworkVersion)')</RuntimeFrameworkVersion>
      </FrameworkReference>
    </ItemGroup>
  </Target>
</Project>
