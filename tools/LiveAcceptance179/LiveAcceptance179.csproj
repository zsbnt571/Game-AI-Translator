<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>Regression026</AssemblyName></PropertyGroup>
  <ItemGroup><Reference Include="GameTranslator"><HintPath>$(FusionAssembly)</HintPath></Reference><PackageReference Include="System.Text.Json" Version="9.0.1" /></ItemGroup>
  <PropertyGroup><FusionApplicationRoot>$([System.IO.Path]::GetDirectoryName('$(FusionAssembly)'))</FusionApplicationRoot></PropertyGroup>
  <ItemGroup><Content Include="$(FusionApplicationRoot)\adapters\**\*" Link="adapters\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
