<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>VGAudio</id>
    <version>2.2.1</version>
    <authors>Alex Barney</authors>
    <owners>Alex Barney</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>https://raw.githubusercontent.com/Thealexbarney/VGAudio/master/LICENSE</licenseUrl>
    <projectUrl>https://github.com/Thealexbarney/VGAudio</projectUrl>
    <description>A library for encoding, decoding, and manipulating audio files from video games.</description>
    <copyright>Copyright © 2016 Alex Barney</copyright>
    <tags>audio dspadpcm adpcm brstm Nintendo</tags>
    <repository type="git" url="https://github.com/Thealexbarney/VGAudio" />
    <dependencies>
      <group targetFramework=".NETFramework4.5" />
      <group targetFramework=".NETStandard1.1">
        <dependency id="NETStandard.Library" version="1.6.1" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Tasks.Parallel" version="4.3.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>