        <dependency id="GenericReader" version="2.3.0" exclude="Build,Analyzers" />
        <dependency id="Infrablack.UE4Config" version="0.7.2.97" exclude="Build,Analyzers" />
        <dependency id="K4os.Compression.LZ4.Streams" version="1.3.8" exclude="Build,Analyzers" />
        <dependency id="LZMA-SDK" version="22.1.1" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.4" exclude="Build,Analyzers" />
        <dependency id="OffiUtils" version="3.2.0" exclude="Build,Analyzers" />
        <dependency id="Oodle.NET" version="2.2.0" exclude="Build,Analyzers" />
        <dependency id="OodleSharp" version="0.0.1" exclude="Build,Analyzers" />
