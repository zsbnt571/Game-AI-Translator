        <dependency id="System.Numerics.Tensors" version="10.0.10" exclude="Build,Analyzers" />
        <dependency id="VGAudio" version="2.2.1" exclude="Build,Analyzers" />
        <dependency id="Zlib-ng.NET" version="1.2.0" exclude="Build,Analyzers" />
        <dependency id="ZstdSharp.Port" version="0.8.8" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
